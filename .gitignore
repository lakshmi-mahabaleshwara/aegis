# ========================
# Python
# ========================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.whl

# ========================
# Virtual Environment
# ========================
venv/
.venv/
env/

# ========================
# Staging / Data Folders
# (track folders via .gitkeep, ignore contents)
# ========================
staging_input/*
!staging_input/.gitkeep
staging_output/*
output/*
!staging_output/.gitkeep
staging_not_processed/*
!staging_not_processed/.gitkeep

# ========================
# OS / IDE
# ========================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ========================
# EasyOCR Model Cache
# ========================
.EasyOCR/

# ========================
# Benchmark
# (commit pydicom_samples/ as a smoke fixture; ignore everything else)
# ========================
tests/benchmark/results/
tests/benchmark/public_dataset/tcia_*
tests/benchmark/public_dataset/rsna_*
tests/benchmark/public_dataset/busi_*
tests/benchmark/public_dataset/nih_*
tests/benchmark/public_dataset/ground_truth/

# ========================
# Miscellaneous
# ========================
*.log
.env
