{
  "mcpServers": {
    "aegis": {
      "command": "${AEGIS_ROOT}/venv/bin/python",
      "args": ["${AEGIS_ROOT}/aegis_mcp_server.py"],
      "env": {
        "AEGIS_OUTPUT_DIR": "${AEGIS_ROOT}/staging_output",
        "AEGIS_REVIEW_DIR": "${AEGIS_ROOT}/staging_not_processed",
        "AEGIS_DEVICE": "${AEGIS_DEVICE:-cpu}"
      }
    }
  }
}
